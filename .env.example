# ─── Core ───────────────────────────────────────────────────────────────
# Long random string used to sign tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Database connection.
# LOCAL DEV: leave as the sqlite file below (no external DB needed).
# PRODUCTION (Neon): set to your Postgres connection string, e.g.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# The app auto-selects Postgres when this starts with "postgres", else SQLite.
DATABASE_URI=file:./zenfest.db

# Public base URL of the site (used for admin, CORS, emails, OG tags).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Media storage (production only) ────────────────────────────────────
# Vercel Blob read/write token. When set, uploaded images are stored in
# Vercel Blob instead of the local filesystem (required on Vercel).
BLOB_READ_WRITE_TOKEN=

# ─── Email notifications (optional) ─────────────────────────────────────
# Where inquiry / vendor submissions are emailed.
LEAD_NOTIFICATION_EMAIL=zenfestevents@gmail.com
# SMTP transport. When SMTP_HOST is set, notification emails are sent.
# Leave blank in local dev (submissions are still saved to the database).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=zenfestevents@gmail.com

# ─── Airtable (optional) ────────────────────────────────────────────────
# Photography vendor applications are copied to one Airtable base (see
# "Vendor applications → Airtable" in README.md). Leave blank to skip.
AIRTABLE_TOKEN=
AIRTABLE_PHOTO_BASE_ID=
AIRTABLE_PHOTO_TABLE=Vendor Applications
# Cake applications go to the "Cake Vendors" base (Bakers workspace): one
# "Vendors" row + one "Flavour Prices" row per flavour, certificate attached.
AIRTABLE_CAKE_BASE_ID=appcZifMTnWKniVOR

# ─── WhatsApp phone verification (optional) ─────────────────────────────
# Vendors verify their number by sending a prefilled WhatsApp message to us
# (see "Phone verification (WhatsApp)" in README.md).
# Unset → local dev shows a "Simulate WhatsApp send" test button; production
# skips verification entirely. Both of these set → verification is live.
# Our WhatsApp number with country code, no + (e.g. 919080089530).
WHATSAPP_BUSINESS_NUMBER=
# Meta app → App settings → Basic → App secret.
WHATSAPP_APP_SECRET=
# Any long random string; also typed into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Optional: send a free "Verified ✓" reply in the chat.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Zenfest AI (optional) ──────────────────────────────────────────────
# The AI event planner (chat bubble, homepage band, /plan) runs on open-source
# models through any OpenAI-compatible host. Default: Groq, free tier, no card —
# console.groq.com → API Keys. Unset → the AI is off and its buttons go to /contact.
AI_API_KEY=
# Defaults shown; change to use another host (OpenRouter, Together, local Ollama
# at http://localhost:11434/v1 — no key needed) or other open models.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_COORDINATOR_MODEL=qwen/qwen3.8-27b
# Used automatically when the coordinator model fails or runs out of free quota.
AI_COORDINATOR_FALLBACK_MODEL=openai/gpt-oss-120b
AI_SPECIALIST_MODEL=openai/gpt-oss-120b
# Optional second host just for the specialists (spreads free-tier quotas).
AI_SPECIALIST_BASE_URL=
AI_SPECIALIST_API_KEY=
# Daily spend cap in USD on paid plans (default 5). Over it, the chat only collects a number.
ZENFEST_AI_DAILY_USD_CAP=

# ─── Gift registry affiliate links (optional) ───────────────────────────
# Applied when a guest is sent to a store from a registry (/r/<slug>/go/<id>),
# so setting these later also covers registries that already exist.
# Amazon Associates tracking ID, e.g. zenfest-21. Blank → plain Amazon links.
AMAZON_ASSOCIATE_TAG=
# Redirect wrapper for every other store (Cuelinks, EarnKaro…), with {url}
# where the encoded product link goes, e.g.
#   https://linksredirect.com/?cid=YOUR_ID&source=linkkit&url={url}
# Blank → plain store links.
AFFILIATE_REDIRECT_TEMPLATE=
